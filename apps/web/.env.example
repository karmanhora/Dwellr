# dwellr — public Supabase configuration
#
# Copy this file to apps/web/.env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# These two values are public by design (they ship in the browser bundle);
# Row Level Security is what protects data. Never put the service role key
# or the database password in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com

# Waitlist-only mode. Local/preview: false. Production: true (see docs/WAITLIST.md).
WAITLIST_ONLY=false

# Server-only secrets. Generate each with `openssl rand -hex 32`.
# Never commit real values.
WAITLIST_IP_SALT=replace-with-a-long-random-value
WAITLIST_UNSUBSCRIBE_SECRET=replace-with-a-different-long-random-value

# Optional: Resend welcome email. The form works with this disabled.
WAITLIST_EMAIL_ENABLED=false
RESEND_API_KEY=
WAITLIST_EMAIL_FROM="dwellr <hello@your-domain.example>"

# Optional: PostHog analytics. Public project key only; leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
