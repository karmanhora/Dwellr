{
  "name": "dwellr",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dwellr/web dev",
    "build": "pnpm --filter @dwellr/web build",
    "start": "pnpm --filter @dwellr/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
